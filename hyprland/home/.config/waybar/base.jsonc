// Waybar base config: neutral layout and modules
// config.jsonc includes this file; module formats come from the Fedora defaults
{
    "include": ["/etc/xdg/waybar/config.jsonc"],
    "modules-left": ["tray"],
    "modules-center": ["hyprland/workspaces", "wlr/taskbar"],
    "modules-right": ["clock", "battery", "pulseaudio", "pulseaudio/slider", "backlight", "backlight/slider", "network", "bluetooth", "custom/powermenu"],
    // Taskbar: windows from all workspaces and monitors; click focuses, middle click closes
    "wlr/taskbar": {
        "all-outputs": true,
        "on-click": "activate",
        "on-click-middle": "close"
    },
    // Volume: a right click opens the audio menu and shows the slider next to it
    // The slider is 0 px wide until audio-menu.sh writes audio-slider.css (see style.css)
    "pulseaudio/slider": {
        "min": 0,
        "max": 100
    },
    // null drops Fedora's pavucontrol on left click
    "pulseaudio": {
        "on-click": null,
        "on-click-right": "~/.config/hypr/scripts/audio-menu.sh"
    },
    // Brightness: a right click opens the display menu and shows the slider next to it
    // The slider is 0 px wide until display-menu.sh writes backlight-slider.css (see style.css)
    // min 5: the panel never goes black (waybar #3359 drops to min after DPMS)
    "backlight/slider": {
        "min": 5,
        "max": 100
    },
    // "" replaces the built-in scroll brightness change (waybar #4893 can hang the bar)
    "backlight": {
        "on-click-right": "~/.config/hypr/scripts/display-menu.sh",
        "on-scroll-up": "",
        "on-scroll-down": ""
    },
    // Battery: a right click opens the battery menu (charge, remaining time, power profiles)
    "battery": {
        "on-click-right": "~/.config/hypr/scripts/battery-menu.sh"
    },
    "clock": {
        "format": "{:%a %d.%m.  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    // Wi-Fi and Bluetooth replace nm-applet and blueman-applet in the tray (both off via XDG autostart)
    // null drops the Fedora click-to-toggle format of network
    "network": {
        "format-alt": null,
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
        // Wi-Fi list below the right island; nm-connection-editor is its "Mehr…" entry
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh"
    },
    "bluetooth": {
        "tooltip-format": "{controller_alias}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        // Device list below the right island; blueman-manager is its "Mehr…" entry
        "on-click": "~/.config/hypr/scripts/bt-menu.sh"
    },
    // Own name: the Fedora defaults already define custom/power with another menu
    "custom/powermenu": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    }
}
